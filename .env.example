# Copy to .env and fill in real values. scripts/install.sh generates strong
# secrets automatically for anything left as CHANGE_ME - never commit a real
# .env file (it is gitignored).

ENVIRONMENT=development

ORGANIZATION_DEFAULT_CURRENCY=SAR
ORGANIZATION_DEFAULT_TIMEZONE=Asia/Riyadh

# Postgres
POSTGRES_USER=rabit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rabit_os
DATABASE_URL=postgresql+psycopg://rabit:CHANGE_ME@localhost:5432/rabit_os

# Redis
REDIS_URL=redis://localhost:6379/0

# Sessions / auth
SESSION_SECRET_KEY=CHANGE_ME
SESSION_COOKIE_NAME=rabit_session
SESSION_TTL_SECONDS=43200

# CORS - comma separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Claude Code CLI (Claude Max login, NOT an API key)
CLAUDE_CLI_PATH=claude
CLAUDE_WORKER_WORKSPACE_ROOT=workspace

# Domain for Nginx/TLS - leave blank to skip certbot in scripts/install.sh
DOMAIN=

# Host-side ports Nginx proxies to for the web/api containers. Deliberately
# NOT 3000/8000: a VPS already running other Node/Python apps very likely
# has those taken (this is a real scenario this project has hit, not a
# hypothetical) - the browser never talks to these ports directly, only
# Nginx does, so change them only if 18080/18081 themselves collide with
# something already on the box.
WEB_PORT=18080
API_PORT=18081

LOG_LEVEL=INFO

# --- Optional integrations: leave blank/unset to keep them "not configured" ---
GITHUB_TOKEN=
VERCEL_TOKEN=
SENTRY_DSN=
POSTHOG_API_KEY=
GOOGLE_ANALYTICS_CREDENTIALS_PATH=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_PATH=
GOOGLE_ADS_CREDENTIALS_PATH=
EMAIL_SMTP_URL=
SUPPORT_PLATFORM_API_KEY=
PAYMENT_PROCESSOR_API_KEY=
